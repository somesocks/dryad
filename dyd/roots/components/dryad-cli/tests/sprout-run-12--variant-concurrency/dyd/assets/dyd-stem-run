#!/usr/bin/env bash
set -euf -o pipefail

. "$DYD_STEM/dyd/dependencies/sprout-run-fixtures/dyd/assets/sprout-run-fixtures.sh"
sprout_fixture_setup one
run=(sprout run dyd/sprouts/one --scope=none --log-level=info --log-format=json)

sprout_fixture_concurrency_case 2 '' 'one-a one-b' "${run[@]}" --variant=flavor=a,b -- hold
sprout_fixture_concurrency_case 2 '' 'one-a one-b' "${run[@]}" --variant=flavor=a,b --parallel=2 -- hold
sprout_fixture_concurrency_case 1 '' 'one-a one-b one-c' "${run[@]}" --variant=flavor=a,b,c --parallel=1 -- hold

sprout_fixture_start '' 'one-a one-b' "${run[@]}" --variant=flavor=a,b --parallel=2 -- fail-hold
sprout_fixture_wait_started 2
sprout_fixture_release one-a
sprout_fixture_wait_failure
sprout_fixture_release one-b
sprout_fixture_finish 1
sprout_fixture_assert_contains "$RUN_TEMP/stderr" 'error running sprout variant flavor=a'
sprout_fixture_assert_content "$RUN_GARDEN/results/one-b" done
sprout_fixture_assert_absent one-a
sprout_fixture_assert_content "$RUN_GARDEN/control/active" 0
