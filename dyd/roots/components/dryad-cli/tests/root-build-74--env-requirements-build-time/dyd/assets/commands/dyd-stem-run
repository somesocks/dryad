#!/usr/bin/env bash
set -euf -o pipefail

TEMP_DIR=''

assert_file_content_equals() {
	file="$1"
	expected="$2"
	if [ ! -f "$file" ]; then
		echo "[ERROR] Fail: file '$file' does not exist" 1>&2
		return 1
	fi
	actual=$(cat "$file")
	if [ "$actual" != "$expected" ]; then
		echo "[ERROR] Fail: file '$file' content does not match. expected ($expected), got ($actual)" 1>&2
		return 1
	fi
}

assert_file_not_exists() {
	if [ -f "$1" ]; then
		echo "[ERROR] Fail: file '$1' exists" 1>&2
		return 1
	fi
}

_setup() {
	TEMP_DIR=`mktemp -d 2>/dev/null || mktemp -d -t 'build-dir'`
	mkdir -p "$TEMP_DIR/dyd/roots"
	printf 'garden' > "$TEMP_DIR/dyd/type"
	cd "$TEMP_DIR"
}

_create_build_root() {
	root_name="$1"
	req_name="$2"
	req_target="$3"
	injected_name="$4"
	mkdir -p "dyd/roots/$root_name/dyd/requirements" "dyd/roots/$root_name/dyd/commands" "dyd/roots/$root_name/dyd/assets"
	printf 'root' > "dyd/roots/$root_name/dyd/type"
	printf '%s' "$req_target" > "dyd/roots/$root_name/dyd/requirements/$req_name"
	cat > "dyd/roots/$root_name/dyd/commands/dyd-root-build" <<EOF
#!/usr/bin/env sh
set -eu
value=\${$injected_name}
printf '%s' "\$value" > "\$DYD_BUILD/dyd/assets/value"
mkdir -p "\$DYD_GARDEN/dyd/heap/env-requirements-01"
printf 'ran' > "\$DYD_GARDEN/dyd/heap/env-requirements-01/$root_name-ran"
cat "\$DYD_STEM/dyd/requirements/$injected_name" > "\$DYD_BUILD/dyd/assets/materialized-$req_name"
EOF
	chmod +x "dyd/roots/$root_name/dyd/commands/dyd-root-build"
}

_expect_build_fails() {
	root_name="$1"
	shift
	set +e
	output=$("$@" dryad root build "dyd/roots/$root_name" --log-level=info 2>&1)
	status=$?
	set -e
	if [ "$status" -eq 0 ]; then
		echo "[ERROR] Fail: expected build of $root_name to fail" 1>&2
		printf '%s\n' "$output" 1>&2
		return 1
	fi
}

_test() {
	_create_build_root root-inject build-value env:DRYAD_TEST_BUILD_VALUE BUILD_VALUE
	DRYAD_TEST_BUILD_VALUE='one' dryad root build dyd/roots/root-inject --log-level=info
	assert_file_content_equals "$TEMP_DIR/dyd/sprouts/root-inject/dyd/dependencies/stem/dyd/assets/value" 'one'

	_create_build_root root-missing missing env:DRYAD_TEST_MISSING MISSING
	_expect_build_fails root-missing env -u DRYAD_TEST_MISSING
	assert_file_not_exists "$TEMP_DIR/dyd/heap/env-requirements-01/root-missing-ran"

	_create_build_root root-cache build-value env:DRYAD_TEST_BUILD_VALUE BUILD_VALUE
	DRYAD_TEST_BUILD_VALUE='one' dryad root build dyd/roots/root-cache --log-level=info 2>&1 | tee "$TEMP_DIR/cache-1.log"
	DRYAD_TEST_BUILD_VALUE='one' dryad root build dyd/roots/root-cache --log-level=info 2>&1 | tee "$TEMP_DIR/cache-2.log"
	if grep -F "root build - building root" "$TEMP_DIR/cache-2.log" | grep -F "root-cache" >/dev/null 2>&1; then
		echo "[ERROR] Fail: expected same env value to reuse root-cache derivation" 1>&2
		cat "$TEMP_DIR/cache-2.log" 1>&2
		return 1
	fi
	DRYAD_TEST_BUILD_VALUE='two' dryad root build dyd/roots/root-cache --log-level=info 2>&1 | tee "$TEMP_DIR/cache-3.log"
	if ! grep -F "root build - building root" "$TEMP_DIR/cache-3.log" | grep -F "root-cache" >/dev/null 2>&1; then
		echo "[ERROR] Fail: expected changed env value to rebuild root-cache" 1>&2
		cat "$TEMP_DIR/cache-3.log" 1>&2
		return 1
	fi
	assert_file_content_equals "$TEMP_DIR/dyd/sprouts/root-cache/dyd/dependencies/stem/dyd/assets/value" 'two'

	materialized=$(cat "$TEMP_DIR/dyd/sprouts/root-cache/dyd/dependencies/stem/dyd/assets/materialized-build-value")
	_create_build_root root-fp-match build-value "$materialized" BUILD_VALUE
	DRYAD_TEST_BUILD_VALUE='two' dryad root build dyd/roots/root-fp-match --log-level=info
	assert_file_content_equals "$TEMP_DIR/dyd/sprouts/root-fp-match/dyd/dependencies/stem/dyd/assets/value" 'two'
	_create_build_root root-fp-mismatch build-value "$materialized" BUILD_VALUE
	_expect_build_fails root-fp-mismatch env DRYAD_TEST_BUILD_VALUE='three'
	assert_file_not_exists "$TEMP_DIR/dyd/heap/env-requirements-01/root-fp-mismatch-ran"

	_create_build_root root-canonical my-build-value env:dryad-test-build-value MY_BUILD_VALUE
	DRYAD_TEST_BUILD_VALUE='canonical' dryad root build dyd/roots/root-canonical --log-level=info
	assert_file_content_equals "$TEMP_DIR/dyd/sprouts/root-canonical/dyd/dependencies/stem/dyd/assets/value" 'canonical'

	_create_build_root root-invalid-alias 1bad env:DRYAD_TEST_BUILD_VALUE BAD
	_expect_build_fails root-invalid-alias env DRYAD_TEST_BUILD_VALUE='bad'
	_create_build_root root-invalid-target value env:1bad VALUE
	_expect_build_fails root-invalid-target env VALUE='bad'
}

_test_defaults() {
	_create_build_root root-default build-value 'env:DRYAD_TEST_BUILD_VALUE?default=0' BUILD_VALUE
	env -u DRYAD_TEST_BUILD_VALUE dryad root build dyd/roots/root-default --log-level=info
	assert_file_content_equals "$TEMP_DIR/dyd/sprouts/root-default/dyd/dependencies/stem/dyd/assets/value" '0'
	materialized=$(cat "$TEMP_DIR/dyd/sprouts/root-default/dyd/dependencies/stem/dyd/assets/materialized-build-value")
	case "$materialized" in
		'env:DRYAD_TEST_BUILD_VALUE?default=0&fingerprint=v2-'*) ;;
		*) echo "[ERROR] Fail: default was not preserved in $materialized" >&2; return 1 ;;
	esac

	# Both another fallback build and a host value equal to the default reuse the derivation.
	rm "$TEMP_DIR/dyd/heap/env-requirements-01/root-default-ran"
	env -u DRYAD_TEST_BUILD_VALUE dryad root build dyd/roots/root-default --log-level=info
	assert_file_not_exists "$TEMP_DIR/dyd/heap/env-requirements-01/root-default-ran"
	DRYAD_TEST_BUILD_VALUE='0' dryad root build dyd/roots/root-default --log-level=info
	assert_file_not_exists "$TEMP_DIR/dyd/heap/env-requirements-01/root-default-ran"

	DRYAD_TEST_BUILD_VALUE='override' dryad root build dyd/roots/root-default --log-level=info
	assert_file_content_equals "$TEMP_DIR/dyd/heap/env-requirements-01/root-default-ran" 'ran'
	assert_file_content_equals "$TEMP_DIR/dyd/sprouts/root-default/dyd/dependencies/stem/dyd/assets/value" 'override'

	DRYAD_TEST_BUILD_VALUE='' dryad root build dyd/roots/root-default --log-level=info
	assert_file_content_equals "$TEMP_DIR/dyd/sprouts/root-default/dyd/dependencies/stem/dyd/assets/value" ''

	_create_build_root root-default-empty build-value 'env:DRYAD_TEST_BUILD_VALUE?default=' BUILD_VALUE
	env -u DRYAD_TEST_BUILD_VALUE dryad root build dyd/roots/root-default-empty --log-level=info
	assert_file_content_equals "$TEMP_DIR/dyd/sprouts/root-default-empty/dyd/dependencies/stem/dyd/assets/value" ''

	# Locked requirements verify defaulted values as well as host values.
	_create_build_root root-default-locked build-value "$materialized" BUILD_VALUE
	env -u DRYAD_TEST_BUILD_VALUE dryad root build dyd/roots/root-default-locked --log-level=info
	assert_file_content_equals "$TEMP_DIR/dyd/sprouts/root-default-locked/dyd/dependencies/stem/dyd/assets/value" '0'
	_expect_build_fails root-default-locked env DRYAD_TEST_BUILD_VALUE='different'

	# CLI addition and listing preserve URL-encoded and empty defaults.
	_create_build_root root-default-cli build-value 'env:DRYAD_TEST_BUILD_VALUE' BUILD_VALUE
	(
		cd "$TEMP_DIR/dyd/roots/root-default-cli"
		dryad root requirement add 'env:DRYAD_TEST_BUILD_VALUE?default=hello%20world%26%2B' build-value --log-level=info
	)
	assert_file_content_equals "$TEMP_DIR/dyd/roots/root-default-cli/dyd/requirements/build-value" 'env:DRYAD_TEST_BUILD_VALUE?default=hello+world%26%2B'
	listing=$(dryad root requirements list dyd/roots/root-default-cli --log-level=info)
	case "$listing" in
		*'env:DRYAD_TEST_BUILD_VALUE?default=hello+world%26%2B'*) ;;
		*) echo "[ERROR] Fail: default missing from requirements listing" >&2; return 1 ;;
	esac
	env -u DRYAD_TEST_BUILD_VALUE dryad root build dyd/roots/root-default-cli --log-level=info
	assert_file_content_equals "$TEMP_DIR/dyd/sprouts/root-default-cli/dyd/dependencies/stem/dyd/assets/value" 'hello world&+'
	(
		cd "$TEMP_DIR/dyd/roots/root-default-cli"
		dryad root requirement add 'env:DRYAD_TEST_BUILD_VALUE?default=' build-value --log-level=info
	)
	assert_file_content_equals "$TEMP_DIR/dyd/roots/root-default-cli/dyd/requirements/build-value" 'env:DRYAD_TEST_BUILD_VALUE?default='
}

_teardown() {
	if [ -d "$TEMP_DIR" ]; then
		chmod -R 755 "$TEMP_DIR"
		rm -rf "$TEMP_DIR"
	fi
}

trap _teardown ERR EXIT
_setup
_test
_test_defaults
