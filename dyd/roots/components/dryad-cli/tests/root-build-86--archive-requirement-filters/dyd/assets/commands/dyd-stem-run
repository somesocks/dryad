#!/usr/bin/env bash
set -euf -o pipefail

WORK_DIR=''
GARDEN_DIR=''
SERVER_PID=''

assert_file_content_equals() {
	file="$1"
	expected="$2"
	if [ ! -f "$file" ]; then
		echo "[ERROR] Fail: file '$file' does not exist" 1>&2
		return 1
	fi
	actual=$(cat "$file")
	if [ "$actual" != "$expected" ]; then
		echo "[ERROR] Fail: expected $file to contain ($expected), got ($actual)" 1>&2
		return 1
	fi
}

assert_path_not_exists() {
	if [ -e "$1" ]; then
		echo "[ERROR] Fail: path '$1' exists" 1>&2
		return 1
	fi
}

stop_server() {
	if [ -n "$SERVER_PID" ]; then
		kill "$SERVER_PID" 2>/dev/null || true
		wait "$SERVER_PID" 2>/dev/null || true
		SERVER_PID=''
	fi
}

teardown() {
	stop_server
	if [ -d "$WORK_DIR" ]; then
		chmod -R 755 "$WORK_DIR"
		rm -rf "$WORK_DIR"
	fi
}

setup() {
	WORK_DIR=$(mktemp -d 2>/dev/null || mktemp -d -t 'build-dir')
	GARDEN_DIR="$WORK_DIR/garden"
	mkdir -p "$GARDEN_DIR/dyd/roots" "$GARDEN_DIR/dyd/external"
	printf 'garden' > "$GARDEN_DIR/dyd/type"
	cd "$GARDEN_DIR"
}

start_server() {
	port_file="$WORK_DIR/server.port"
	fixture_path="$DYD_STEM/dyd/assets/case-collision.tar"
	archive_path="$GARDEN_DIR/dyd/external/archive.tar"
	cp "$fixture_path" "$archive_path"
	"$DYD_STEM/dyd/dependencies/http-server/dyd/commands/http-server" "$port_file" "$fixture_path" &
	SERVER_PID=$!
	for _ in {1..100}; do
		if [ -s "$port_file" ]; then
			return 0
		fi
		sleep 0.05
	done
	echo '[ERROR] Fail: http server did not start' 1>&2
	return 1
}

create_consumer_root() {
	root_name="$1"
	mkdir -p "dyd/roots/$root_name/dyd/commands" "dyd/roots/$root_name/dyd/requirements"
	printf 'root' > "dyd/roots/$root_name/dyd/type"
	cat > "dyd/roots/$root_name/dyd/commands/dyd-root-build" <<'EOF'
#!/usr/bin/env sh
set -eu

metadata=$(cat "$DYD_STEM/dyd/dependencies/metadata/dyd/assets/archive/BUILD")
source=$(cat "$DYD_STEM/dyd/dependencies/source/dyd/assets/archive/build/value.txt")

if [ -e "$DYD_STEM/dyd/dependencies/metadata/dyd/assets/archive/build" ]; then
	echo '[ERROR] Fail: metadata dependency contains build' 1>&2
	exit 1
fi
if [ -e "$DYD_STEM/dyd/dependencies/source/dyd/assets/archive/BUILD" ]; then
	echo '[ERROR] Fail: source dependency contains BUILD' 1>&2
	exit 1
fi

mkdir -p "$DYD_BUILD/dyd/assets"
printf '%s|%s' "$metadata" "$source" > "$DYD_BUILD/dyd/assets/summary.txt"
EOF
	chmod +x "dyd/roots/$root_name/dyd/commands/dyd-root-build"
}

assert_http_target() {
	target="$1"
	include="$2"
	exclude="$3"
	suffix="&unpack=true&$include"
	if [ -n "$exclude" ]; then
		suffix="$suffix&$exclude"
	fi
	case "$target" in
		*'#fingerprint=v2-'*"$suffix") ;;
		*)
			echo "[ERROR] Fail: unexpected locked http target: $target" 1>&2
			return 1
			;;
	esac
}

test_file_requirement() {
	create_consumer_root root-file
	(
		cd dyd/roots/root-file
		dryad root requirement add file:../../../../external/archive.tar metadata --unpack=true --include=BUILD --include=build --exclude=build --log-level=info
		dryad root requirement add file:../../../../external/archive.tar source --unpack=true --include=build --log-level=info
	)
	assert_file_content_equals dyd/roots/root-file/dyd/requirements/metadata 'file:../../../../external/archive.tar?unpack=true&include=BUILD&include=build&exclude=build'
	assert_file_content_equals dyd/roots/root-file/dyd/requirements/source 'file:../../../../external/archive.tar?unpack=true&include=build'
	dryad root build dyd/roots/root-file --log-level=info > /dev/null 2>&1
	assert_file_content_equals dyd/sprouts/root-file/dyd/dependencies/stem/dyd/assets/summary.txt 'metadata|source'
}

test_http_requirement() {
	create_consumer_root root-http
	port=$(cat "$WORK_DIR/server.port")
	archive_url="http://127.0.0.1:$port/archive.tar?download=1"
	(
		cd dyd/roots/root-http
		dryad root requirement add "$archive_url" metadata --unpack=true --include=BUILD --include=build --exclude=build --log-level=info
		dryad root requirement add "$archive_url" source --unpack=true --include=build --log-level=info
	)
	assert_http_target "$(cat dyd/roots/root-http/dyd/requirements/metadata)" 'include=BUILD&include=build' 'exclude=build'
	assert_http_target "$(cat dyd/roots/root-http/dyd/requirements/source)" 'include=build' ''
	dryad root build dyd/roots/root-http --log-level=info > /dev/null 2>&1
	assert_file_content_equals dyd/sprouts/root-http/dyd/dependencies/stem/dyd/assets/summary.txt 'metadata|source'
}

trap 'echo "[ERROR] Fail near line $LINENO" 1>&2; teardown' ERR
trap teardown EXIT
setup
start_server
test_file_requirement
test_http_requirement
